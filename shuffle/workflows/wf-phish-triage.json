      "parameters": [
        {
          "description": "",
          "id": "",
          "name": "code",
          "example": "",
          "value": "import json, urllib.request\n\nGEMMA = \"$gemma_url/api/generate\"\nMODEL = \"gemma4:12b\"\nPROMPT = (\"You are a SOC phishing analyst examining a screenshot of a web page or email. \"\n          \"Decide whether it is a credential-phishing or brand-impersonation lure. Base the \"\n          \"verdict ONLY on what is visible and cite concrete visual cues. Respond with ONLY this \"\n          \"JSON: {\\\"brand_impersonated\\\":\\\"<brand or none>\\\",\\\"is_phishing\\\":<true|false>,\"\n          \"\\\"confidence\\\":<0.0-1.0>,\\\"red_flags\\\":[\\\"<visible cue>\\\"],\\\"summary\\\":\\\"<one sentence>\\\"}\")\n\nraw = \"\"\nif isinstance(self.full_execution, dict):\n    raw = self.full_execution.get(\"execution_argument\", \"\") or \"\"\ntry:\n    payload = json.loads(raw) if raw else {}\nexcept Exception:\n    payload = {}\n\nimg = payload.get(\"image_b64\") or payload.get(\"image\") or \"\"\nsource = str(payload.get(\"source\", payload.get(\"reporter\", \"manual\")))[:120]\n\ndef san(s):\n    return str(s).replace('\"', \"'\").replace(\"\\\\\", \"\").replace(\"\\n\", \" \").replace(\"\\r\", \" \").strip()\n\nif not img:\n    print(json.dumps({\"combined\": \"**Phishing Triage** | error: no image_b64 in webhook payload\",\n                      \"is_phishing\": \"false\", \"error\": \"no_image\"}))\nelse:\n    body = json.dumps({\"model\": MODEL, \"prompt\": PROMPT, \"images\": [img], \"stream\": False,\n                       \"format\": \"json\",\n                       \"options\": {\"num_predict\": 1024, \"temperature\": 0, \"num_ctx\": 8192}}).encode()\n    try:\n        req = urllib.request.Request(GEMMA, data=body,\n                                     headers={\"Content-Type\": \"application/json\"}, method=\"POST\")\n        resp = urllib.request.urlopen(req, timeout=180)\n        out = json.loads(resp.read().decode())\n        rv = out.get(\"response\", \"\")\n        try:\n            v = json.loads(rv)\n        except Exception:\n            i, j = rv.find(\"{\"), rv.rfind(\"}\")\n            v = json.loads(rv[i:j + 1]) if i >= 0 and j > i else {}\n        is_phish = bool(v.get(\"is_phishing\"))\n        brand = san(v.get(\"brand_impersonated\", \"unknown\"))\n        conf = v.get(\"confidence\", \"\")\n        summary = san(v.get(\"summary\", \"\"))\n        flags = v.get(\"red_flags\", []) or []\n        flag_txt = san(\"; \".join(str(f) for f in flags))[:600]\n        head = \"PHISHING\" if is_phish else \"looks clean\"\n        lines = [\"**Phishing Triage**\",\n                 \"Verdict: \" + head + \" (brand: \" + brand + \", confidence: \" + str(conf) + \")\",\n                 \"Summary: \" + summary,\n                 \"Flags: \" + (flag_txt or \"none\"),\n                 \"Source: \" + san(source)]\n        combined = \"\\\\n\".join(lines)\n        if len(combined) > 1950:\n            combined = combined[:1947] + \"...\"\n        print(json.dumps({\"combined\": combined, \"is_phishing\": str(is_phish).lower(),\n                          \"brand\": brand, \"confidence\": conf}))\n    except Exception as e:\n        print(json.dumps({\"combined\": \"**Phishing Triage** | model error: \" + san(str(e))[:200],\n                          \"is_phishing\": \"false\", \"error\": \"model\"}))\n",
