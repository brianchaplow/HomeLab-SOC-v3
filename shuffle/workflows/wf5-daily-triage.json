      "generated": false,
      "large_image": "data:image/svg+xml;utf-8,%3Csvg%20width=%2224%22%20height=%2224%22%20viewBox=%220%200%2048%2048%22%20version=%221.1%22%20xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cpath%20d=%22M17.3335%2028.1667L22.3335%2023.1667L17.3335%2018.1667%20M24%2029.8333H30.6667%22%20fill=%22none%22%20stroke=%22white%22%20stroke-width=%221.5%22%20stroke-linecap=%22round%22%20stroke-linejoin=%22round%22/%3E%3C/svg%3E",
      "environment": "Shuffle",
      "name": "execute_python",
      "parameters": [
        {
          "description": "",
          "id": "",
          "name": "code",
          "example": "",
          "value": "import json, urllib.request, datetime\n\nresults = self.full_execution.get(\"results\", []) if isinstance(self.full_execution, dict) else []\nclassify_data = {}\nfor r in results:\n    if r.get(\"action\", {}).get(\"label\") == \"classify_clusters\":\n        try:\n            p = json.loads(r.get(\"result\", \"{}\"))\n            classify_data = p.get(\"message\", p) if isinstance(p, dict) else {}\n        except:\n            classify_data = {}\n\ninvestigate_items = classify_data.get(\"investigate_items\", [])\ncreated = []\nerrors = []\nfor item in investigate_items[:5]:\n    try:\n        alert_body = {\n            \"title\": f\"[Triage] {item.get('rule_description', 'Unknown')[:80]} on {item.get('agent', '?')}\",\n            \"description\": f\"Auto-triaged alert cluster flagged for investigation.\\nRule: {item.get('rule_id', '?')} - {item.get('rule_description', '?')}\\nAgent: {item.get('agent', '?')}\\nSource IP: {item.get('src_ip', 'none')}\\nAlert count (24h): {item.get('count', 0)}\\nMax level: {item.get('max_level', 0)}\\nMITRE: {', '.join(item.get('mitre_ids', []))}\\nReason: {item.get('reason', 'Flagged by Ollama triage')}\",\n            \"type\": \"external\",\n            \"source\": \"shuffle-wf5\",\n            \"sourceRef\": f\"wf5-{item.get('rule_id', '0')}-{item.get('agent', 'unknown')}-{datetime.datetime.utcnow().strftime('%Y%m%d')}\",\n            \"severity\": 2,\n            \"tlp\": 2,\n            \"tags\": [\"auto-triage\", \"investigate\", \"ollama\"]\n        }\n        req = urllib.request.Request(\n            \"$thehive_url/api/alert\",\n            data=json.dumps(alert_body).encode(),\n            headers={\n                \"Authorization\": \"Bearer $thehive_api_key\",\n                \"Content-Type\": \"application/json\"\n            },\n            method=\"POST\")\n        resp = urllib.request.urlopen(req, timeout=10)\n        result = json.loads(resp.read().decode())\n        created.append(result.get(\"id\", \"?\"))\n    except urllib.request.HTTPError as e:\n        body = e.read().decode()[:200] if hasattr(e, 'read') else ''\n        errors.append(f\"{e}: {body}\")\n    except Exception as e:\n        errors.append(str(e)[:100])\n\nprint(json.dumps({\"created_alerts\": created, \"errors\": errors, \"total_investigate\": len(investigate_items)}))",
