      "sharing": true,
      "label": "format_alert",
      "public": true,
      "generated": false,
      "environment": "Shuffle",
      "name": "execute_python",
      "parameters": [
        {
          "description": "",
          "id": "",
          "name": "code",
          "example": "",
          "value": "import json\n\ntry:\n    data = json.loads(self.full_execution[\"execution_argument\"])\nexcept:\n    data = {}\n\n# Cron script passes collector results directly as webhook body\ntrades = data.get(\"trades\", {})\nhigh_value = trades.get(\"high_value\", [])\ntrades_new = trades.get(\"trades_new\", 0)\nollama_resolved = trades.get(\"ollama_resolved\", 0)\nerrors = trades.get(\"errors\", [])\n\nif not high_value:\n    print(json.dumps({\"send_alert\": \"false\", \"message\": \"No high-value trades\"}))\nelse:\n    lines = [\"**Capitol Signals -- New High-Value Trades**\", \"----------------------------------------\"]\n    for t in high_value[:10]:\n        chamber = \"Sen.\" if t.get(\"chamber\") == \"Senate\" else \"Rep.\"\n        name = t.get(\"member_name\", \"Unknown\")\n        party = t.get(\"party\", \"?\")\n        ticker = t.get(\"ticker\", \"???\")\n        company = t.get(\"company_name\", \"\")\n        tx_type = t.get(\"transaction_type\", \"\").replace(\"_\", \" \").title()\n        amount = t.get(\"amount_range\", \"\")\n        lag = t.get(\"disclosure_lag_days\", 0)\n        disclosure = t.get(\"disclosure_date\", \"\")\n        in_juris = t.get(\"in_jurisdiction\", False)\n        comms = \", \".join(t.get(\"committees_with_jurisdiction\", []))\n        line = f\"{chamber} {name} ({party}) -- {ticker}\"\n        if company:\n            line += f\" ({company})\"\n        lines.append(line)\n        detail = f\"  {tx_type}: {amount}\"\n        if in_juris:\n            detail += f\" | {comms} | IN JURISDICTION\"\n        lines.append(detail)\n        lines.append(f\"  Filed: {disclosure} ({lag} day lag)\")\n        lines.append(\"\")\n    lines.append(\"----------------------------------------\")\n    lines.append(f\"{trades_new} new trades | {ollama_resolved} Ollama-resolved | {len(errors)} errors\")\n    message = \"\\\\n\".join(lines)\n    message = message.replace('\"', \"'\").replace(\"\\\\\", \"\")\n    if len(message) > 1950:\n        message = message[:1947] + \"...\"\n    print(json.dumps({\"send_alert\": \"true\", \"message\": message}))\n",
