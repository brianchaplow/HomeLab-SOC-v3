      "environment": "Shuffle",
      "name": "execute_python",
      "parameters": [
        {
          "description": "",
          "id": "",
          "name": "code",
          "example": "",
          "value": "import json, datetime\n\ncs = json.loads('''$query_capitol_signals.message''')\nws = json.loads('''$query_websites.message''')\n\ndef emoji(status):\n    return {'up': '\\ud83d\\udfe2', 'degraded': '\\ud83d\\udfe1', 'down': '\\ud83d\\udd34'}.get(status, '\\u26aa')\n\ndown_count = 0\nif cs.get('status') == 'down': down_count += 1\nfor s in ws.get('sites', []):\n    if s.get('status') == 'down': down_count += 1\n\nif down_count == 0:\n    color = 3066993\nelif down_count == 1:\n    color = 15105570\nelse:\n    color = 15158332\n\nnow_utc = datetime.datetime.utcnow().replace(microsecond=0).isoformat() + 'Z'\ndate_et = datetime.datetime.utcnow().strftime('%Y-%m-%d')\n\nfields = [\n    {'name': 'Capitol Signals', 'value': f\"{emoji(cs.get('status'))} {cs.get('status','?')} \\u00b7 HTTP {cs.get('http_code',0)} \\u00b7 {cs.get('latency_ms',0)}ms\", 'inline': False}\n]\nfor s in ws.get('sites', []):\n    url = s.get('url', '?')\n    name = url.replace('https://','').replace('/','')\n    fields.append({'name': name, 'value': f\"{emoji(s.get('status'))} HTTP {s.get('http_code',0)} \\u00b7 {s.get('latency_ms',0)}ms\", 'inline': False})\nfields.append({'name': 'AlgoTrader', 'value': '\\u23f8 Paused since 2026-04-01', 'inline': False})\n\nembed = {\n    'title': f'Project Status \\u2014 {date_et} ET',\n    'description': 'Daily project health check',\n    'color': color,\n    'fields': fields,\n    'footer': {'text': 'WF-PROJECTS \\u00b7 brisket'},\n    'timestamp': now_utc\n}\nbody = json.dumps({'embeds': [embed]})\nprint(json.dumps({'embed_body': body}))\n",
