          "example": "",
          "value": "import json, urllib.request, urllib.error, socket\n\nresult = {\"status\": \"down\", \"http_code\": 0, \"latency_ms\": 0, \"note\": \"\"}\ntry:\n    import time\n    t0 = time.time()\n    req = urllib.request.Request('http://10.10.20.30:5010/health')\n    resp = urllib.request.urlopen(req, timeout=5)\n    result['http_code'] = resp.status\n    result['latency_ms'] = int((time.time() - t0) * 1000)\n    body = resp.read().decode()\n    result['status'] = 'up' if resp.status == 200 else 'degraded'\n    result['note'] = body[:200].replace('\"', \"'\").replace('\\\\', '')\nexcept (urllib.error.URLError, socket.timeout) as e:\n    result['status'] = 'down'\n    result['note'] = str(e)[:100].replace('\"', \"'\").replace('\\\\', '')\n\nprint(json.dumps(result))\n",
