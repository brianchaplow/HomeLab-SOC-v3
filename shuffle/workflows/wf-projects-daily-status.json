      "name": "execute_python",
      "parameters": [
        {
          "description": "",
          "id": "",
          "name": "code",
          "example": "",
          "value": "import json, urllib.request, urllib.error, socket, time, ssl\n\nctx = ssl.create_default_context()\nctx.check_hostname = False\nctx.verify_mode = ssl.CERT_NONE\n\ndef probe(url):\n    out = {'url': url, 'status': 'down', 'http_code': 0, 'latency_ms': 0}\n    try:\n        t0 = time.time()\n        req = urllib.request.Request(url, method='HEAD', headers={'User-Agent': 'WF-PROJECTS/1.0'})\n        resp = urllib.request.urlopen(req, timeout=5, context=ctx)\n        out['http_code'] = resp.status\n        out['latency_ms'] = int((time.time() - t0) * 1000)\n        out['status'] = 'up' if 200 <= resp.status < 400 else 'degraded'\n    except (urllib.error.URLError, socket.timeout) as e:\n        out['status'] = 'down'\n    return out\n\nsites = [probe('https://brianchaplow.com/'), probe('https://bytesbourbonbbq.com/')]\nprint(json.dumps({'sites': sites}))\n",
