      "id": "a1000003-0000-0000-0000-000000000003",
      "is_valid": true,
      "sharing": true,
      "label": "format_alert",
      "public": true,
      "generated": false,
      "environment": "Shuffle",
      "name": "execute_python",
      "parameters": [
        {
          "description": "",
          "id": "",
          "name": "code",
          "example": "",
          "value": "import json\n\nraw = '$query_elk.message'\ntry:\n    query_data = json.loads(raw) if isinstance(raw, str) else raw\nexcept:\n    query_data = {}\n\nhits = query_data.get(\"hits\", [])\ntotal = query_data.get(\"total\", 0)\n\nif not hits:\n    print(json.dumps({\"message\": \"No stalker visits found\"}))\nelse:\n    lines = []\n    lines.append(\"**STALKER VISIT ALERT**\")\n    lines.append(f\"Detected {total} visit(s) in last 5 minutes:\")\n    lines.append(\"\")\n    for i, h in enumerate(hits[:5]):\n        lines.append(f\"**Visit {i+1}:**\")\n        lines.append(f\"  Fingerprint: `{h.get('fingerprint', 'unknown')}`\")\n        lines.append(f\"  IP: `{h.get('client_ip', 'unknown')}`\")\n        lines.append(f\"  Site: {h.get('site', 'unknown')}\")\n        lines.append(f\"  Page: {h.get('page', 'unknown')}\")\n        geo = f\"{h.get('geo_city', '?')}, {h.get('geo_region', '?')}, {h.get('geo_country', '?')}\"\n        lines.append(f\"  Location: {geo}\")\n        lines.append(f\"  Time: {h.get('timestamp', 'unknown')}\")\n        ua = h.get(\"user_agent\", \"unknown\")\n        if len(ua) > 80:\n            ua = ua[:77] + \"...\"\n        lines.append(f\"  UA: {ua}\")\n        lines.append(\"\")\n\n    if total > 5:\n        lines.append(f\"... and {total - 5} more visit(s)\")\n\n    msg = \"\\\\n\".join(lines)\n    msg = msg.replace('\"', \"'\")\n    if len(msg) > 1950:\n        msg = msg[:1947] + \"...\"\n    print(json.dumps({\"message\": msg}))\n",
