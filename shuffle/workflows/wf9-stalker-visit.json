      "id": "a1000001-0000-0000-0000-000000000001",
      "is_valid": true,
      "isStartNode": true,
      "sharing": true,
      "label": "query_elk",
      "public": true,
      "generated": false,
      "environment": "Shuffle",
      "name": "execute_python",
      "parameters": [
        {
          "description": "",
          "id": "",
          "name": "code",
          "example": "",
          "value": "import json, urllib.request, ssl, base64\n\nctx = ssl.create_default_context()\nctx.check_hostname = False\nctx.verify_mode = ssl.CERT_NONE\n\nelk_auth = base64.b64encode(\"$elk_user:$elk_pass\".encode()).decode()\n\nquery = {\n    \"query\": {\n        \"bool\": {\n            \"must\": [\n                {\"range\": {\"@timestamp\": {\"gte\": \"now-5m\"}}},\n                {\"bool\": {\"should\": [\n                    {\"term\": {\"client_ip\": \"2600:4040::/32\"}},\n                    {\"terms\": {\"fingerprint\": []}}\n                ], \"minimum_should_match\": 1}}\n            ]\n        }\n    },\n    \"size\": 20,\n    \"sort\": [{\"@timestamp\": \"desc\"}]\n}\n\nreq = urllib.request.Request(\n    \"$elk_url/visitor-fingerprints/_search\",\n    data=json.dumps(query).encode(),\n    headers={\n        \"Content-Type\": \"application/json\",\n        \"Authorization\": \"Basic \" + elk_auth\n    },\n    method=\"POST\"\n)\n\ntry:\n    resp = urllib.request.urlopen(req, context=ctx, timeout=15)\n    data = json.loads(resp.read().decode())\n    hits = data.get(\"hits\", {}).get(\"hits\", [])\n    total = data.get(\"hits\", {}).get(\"total\", {}).get(\"value\", 0)\n    result = {\"has_matches\": str(total > 0).lower(), \"total\": total, \"hits\": []}\n    for h in hits:\n        src = h.get(\"_source\", {})\n        geo = src.get(\"geo\", {})\n        result[\"hits\"].append({\n            \"fingerprint\": src.get(\"fingerprint\", \"unknown\"),\n            \"client_ip\": src.get(\"client_ip\", \"unknown\"),\n            \"site\": src.get(\"site\", \"unknown\"),\n            \"page\": src.get(\"page\", \"unknown\"),\n            \"geo_country\": geo.get(\"country\", \"unknown\"),\n            \"geo_city\": geo.get(\"city\", \"unknown\"),\n            \"geo_region\": geo.get(\"region\", \"unknown\"),\n            \"timestamp\": src.get(\"@timestamp\", \"unknown\"),\n            \"user_agent\": src.get(\"user_agent\", \"unknown\")\n        })\n    print(json.dumps(result))\nexcept Exception as e:\n    print(json.dumps({\"has_matches\": \"false\", \"total\": 0, \"hits\": [], \"error\": str(e)}))\n",
